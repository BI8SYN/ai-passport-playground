#!/usr/bin/env bash
set -euo pipefail
repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${repo_root}"

case "${1:-help}" in
  simulator-build)
    shift
    exec docker compose run --rm --no-deps -T sdk python3 tools/handmic-simulator/build_backend.py "$@"
    ;;
  simulator)
    shift
    exec python3 tools/handmic-simulator/launch.py "$@"
    ;;
  ble-lab-device)
    shift
    exec python3 tools/ble_lab_device.py "$@"
    ;;
  image)
    [[ $# -eq 1 ]] || { echo 'Usage: tools/dev image' >&2; exit 2; }
    exec docker compose build sdk
    ;;
  doctor|gate|build|preview|static|test|cache-stats|clean-builds)
    exec docker compose run --rm --no-deps -T sdk python3 tools/firmware.py "$@"
    ;;
  help|--help|-h)
    cat <<'HELP'
Usage: ./tools/dev COMMAND
  simulator-build        Build the native diagnostic Passport backend in Docker
  simulator              Launch local Web Passport and Mac BLE bridge
  image                  Build the pinned ESP-IDF development image
  doctor                 Check container toolchain and cache paths
  gate                   Run the original upstream full validation gate
  static                 Run upstream static checks and host tests
  build [TARGET]         Build hardware-test (default), upstream, resistor-reader, ear-trainer, ble-signer-lab or rf-link-handmic
  build resistor-reader --benchmark  Build an explicitly marked startup benchmark
  preview resistor-reader Render the real LVGL UI and check font glyphs
  ble-lab-device         Authorized BLE lab inspect/flash/monitor via Docker
  test                   Run local build-tool tests
  cache-stats            Show persistent compiler cache statistics
  clean-builds [TARGET]   Preview obsolete build directories (keep 2 + 1 benchmark)
    --apply              Delete listed disposable build trees
    --keep N --keep-benchmark N  Override retention for this cleanup
No device access, flashing or publishing commands are provided.
HELP
    ;;
  *) echo 'Unknown command. Run ./tools/dev help.' >&2; exit 2 ;;
esac
